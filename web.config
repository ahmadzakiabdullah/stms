<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument enabled="false" />
        <rewrite>
            <rules>
                <clear />
                <!-- Serve the directory root via an internal rewrite so the canonical URL stays clean (/portal/ without index.php). -->
                <rule name="Portal Directory Root" stopProcessing="true">
                    <match url="^$" />
                    <action type="Rewrite" url="index.php" appendQueryString="true" />
                </rule>
                <!-- The IIS worker cannot create/follow the public storage junction
                     in this deployment, so Laravel serves validated public-disk files. -->
                <rule name="Public Storage Through Laravel" stopProcessing="true">
                    <match url="^storage/(.+)$" ignoreCase="true" />
                    <action type="Rewrite" url="index.php" appendQueryString="true" />
                </rule>
                <!-- Block direct access to Laravel application files when IIS points to the project root. -->
                <rule name="Block Laravel Private Files" stopProcessing="true">
                    <match url="(^|/)(\.env.*|\.git|\.svn|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|README\.md|app|bootstrap|config|database|resources|routes|tests|vendor)(/.*)?$" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <!-- Serve static files from public folder (vendors, fonts, images, etc.) -->
                <rule name="Public Static Files" stopProcessing="true">
                    <match url="^(assets|build|js|css|images|fonts|favicon\.ico|robots\.txt|manifest\.json|sw\.js|offline\.html)(.*)$" />
                    <action type="Rewrite" url="public/{R:1}{R:2}" />
                </rule>
                <!-- Rewrite all non-file requests to index.php -->
                <rule name="Laravel Front Controller" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
