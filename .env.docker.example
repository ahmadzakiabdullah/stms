APP_KEY=base64:replace-with-php-artisan-key-generate-show-output
DB_DATABASE=stms
DB_USERNAME=stms
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
