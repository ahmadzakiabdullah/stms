APP_NAME=STMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://saf.utem.edu.my/portal

SESSION_PATH=/portal

# Production database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db4safportal
DB_USERNAME=
DB_PASSWORD=

# Cache & Queue (Redis recommended for production)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail (configure for your provider)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@saf.utem.edu.my
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Timezone
APP_TIMEZONE=Asia/Kuala_Lumpur

# Frontend
VITE_APP_NAME="${APP_NAME}"
