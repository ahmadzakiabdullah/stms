APP_NAME=STMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://saf.utem.edu.my/portal
PUBLIC_ORG_SLUG=utem
PUBLIC_SESSION_SLUG=saf-2026
PUBLIC_REGISTRATION_ENABLED=false
CSP_REPORT_ONLY=false
PRODUCTION_CONFIG_ENFORCE=true
EMAIL_VERIFICATION_REQUIRED=true
DEFAULT_ORG_SLUG=
# Comma-separated proxy IPs/CIDRs. Leave empty when no trusted reverse proxy is used.
TRUSTED_PROXIES=
SEED_DEMO_DATA=false
ALLOW_DEMO_SEEDING=false
BACKUP_ENABLED=true
BACKUP_PATH=
BACKUP_SOURCE_PATH=
# Required in production. Use a long random secret stored outside the repository.
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql
HEALTH_MONITOR_ENABLED=true
HEALTH_ENDPOINT_TOKEN=
HEALTH_MAX_PENDING_JOBS=100
HEALTH_MAX_FAILED_JOBS=0
HEALTH_MIN_DISK_FREE_MB=1024

SESSION_PATH=/portal

# Production database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db4safportal
DB_USERNAME=
DB_PASSWORD=

# Cache & Queue (Redis recommended for production)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Mail (configure for your provider)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@saf.utem.edu.my
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Timezone
APP_TIMEZONE=Asia/Kuala_Lumpur

# Frontend
VITE_APP_NAME="${APP_NAME}"
